# BBSFirewall - Configuration
# Copy this file to .env and adjust the values for your setup.
# https://github.com/SysopNetwork/BBSFirewall

# =============================================================================
# Network
# =============================================================================

# Port to listen on for incoming telnet connections
LISTEN_PORT=23

# Backend BBS server hostname or IP and port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=23

# Encoding-based routing — route CP437 and UTF-8 clients to separate backend ports
# ENCODING_DETECTION=false
# BACKEND_PORT_CP437=2323
# BACKEND_PORT_UTF8=2423

# =============================================================================
# Connection Limits
# =============================================================================

# Maximum total simultaneous connections from all clients combined
MAX_CONNECTIONS=100

# Maximum simultaneous connections allowed from a single client IP address
# Set to 0 to disable the limit and allow unlimited connections per IP
MAX_CONNECTIONS_PER_IP=3

# Connection timeout in milliseconds (0 to disable)
# Default: 300000 (5 minutes)
CONNECTION_TIMEOUT=300000

# How long to wait for the backend TCP connection to establish before dropping
# the session (ms, 0 to disable). Stops a dead/unreachable backend from pinning
# connection slots for the full OS TCP timeout.
# BACKEND_CONNECT_TIMEOUT_MS=10000

# =============================================================================
# Country Blocking (requires GeoIP database — run: npm run setup-geoip)
# =============================================================================

# MaxMind license key — if set, `npm run setup-geoip` downloads the
# GeoLite2-Country database automatically (sign up at
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data)
# MAXMIND_LICENSE_KEY=your_key_here

# Comma-separated list of ISO 3166-1 alpha-2 country codes to block
# BLOCKED_COUNTRIES=CN,RU,KP,IR,BY,SY,AF,IQ,PK

# Block connections when the client country cannot be determined
# BLOCK_UNKNOWN_COUNTRIES=false

# =============================================================================
# IP Lists
# =============================================================================

# Path to IP whitelist file — listed IPs bypass ALL firewall rules
WHITELIST_PATH=./whitelist.txt

# Path to IP blocklist file — listed IPs are permanently blocked
BLOCKLIST_PATH=./blocklist.txt

# =============================================================================
# Rate Limiting (flood protection)
# =============================================================================

# Enable or disable rate limiting
RATE_LIMIT_ENABLED=true

# Maximum connection attempts from a single IP within the time window
MAX_CONNECTIONS_PER_WINDOW=10

# Time window for rate limiting in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# How long to block IPs that exceed the rate limit in milliseconds (default: 300000 = 5 minutes)
RATE_LIMIT_BLOCK_DURATION_MS=300000

# =============================================================================
# Auto-Block Triggers
# Scan the first bytes a telnet/SSH caller sends for known bot / scanner /
# exploit strings and blacklist the source IP on a match. Patterns live in the
# trigger list file (plain substring, or /regex/). Off by default — a real
# caller who sends one of these strings early would be blocked too. Whitelisted
# IPs are exempt. Copy triggers.txt.example to triggers.txt to get started.
# =============================================================================

# TRIGGER_BLOCK_ENABLED=false
# TRIGGER_LIST_PATH=./triggers.txt

# Only the first N bytes the caller sends are checked (16-65536)
# TRIGGER_SCAN_BYTES=1024

# blocklist = append the IP to blocklist.txt permanently (+ block in memory now)
# temp      = in-memory block only, for TRIGGER_BLOCK_DURATION_MS
# TRIGGER_BLOCK_MODE=blocklist
# TRIGGER_BLOCK_DURATION_MS=86400000

# =============================================================================
# PROXY Protocol v1
# Prepends the real client IP to the backend TCP stream so the BBS can see it.
# WARNING: Only enable this if your backend BBS or a companion module supports
# PROXY Protocol. Enabling it against an incompatible backend will break all
# connections — the BBS will receive garbage at the start of every session.
# =============================================================================

# PROXY_PROTOCOL_ENABLED=false

# =============================================================================
# Web Redirect (HTTP — port 80)
# =============================================================================

# Redirect HTTP (port 80) traffic to a configured URL
# Useful for web browsers that visit the firewall's IP address
WEB_REDIRECT_ENABLED=false
WEB_REDIRECT_URL=https://example.com

# =============================================================================
# HTTPS Redirect (port 443)
# Requires a TLS certificate. Run setup-certs.sh to get one from Let's Encrypt.
# WEB_REDIRECT_URL above is used as the redirect destination for both HTTP and HTTPS.
# =============================================================================

# HTTPS_REDIRECT_ENABLED=false
# HTTPS_REDIRECT_PORT=443
# HTTPS_CERT_PATH=./certs/fullchain.pem
# HTTPS_KEY_PATH=./certs/privkey.pem

# Domain + optional contact email for the config editor's "Issue Let's Encrypt
# certificate" button (Tools tab) when it issues the port-443 redirect cert.
# HTTPS_CERT_DOMAIN=bbs.example.com
# HTTPS_CERT_EMAIL=you@example.com

# Directory where certbot writes ACME challenge files during cert verification.
# The HTTP server serves files from this path — do not change unless you know why.
# ACME_WEBROOT=./certs/webroot

# =============================================================================
# Web Config Editor (HTTPS admin UI)
# A browser UI on its own port for editing this .env and the whitelist /
# blocklist / trustedhosts files. Two gates protect it:
#   1. trustedhosts.txt — an IPv4/IPv6 CIDR allowlist. Any address NOT listed
#      is refused before login. An empty or missing file locks everyone out.
#   2. the username / password below — checked with a constant-time compare and
#      exchanged for a short-lived session cookie.
# Run setup-config-cert.sh to create the TLS certificate (Let's Encrypt, or
# --self-signed for IP-only / internal access).
# =============================================================================

# CONFIG_EDITOR_ENABLED=false
# CONFIG_EDITOR_PORT=8443
# CONFIG_EDITOR_BIND=0.0.0.0

# Admin login is no longer set via .env. Run this once to create the account
# (it writes a scrypt-hashed password + MFA store to .admin-security.json):
#   node setup-admin.js
# Change the password or enable MFA afterward from Security Settings in the
# web editor itself (top-right of the header).

# TLS certificate for the editor (written by setup-config-cert.sh or the Tools tab)
# CONFIG_EDITOR_CERT_PATH=./certs/config-editor/fullchain.pem
# CONFIG_EDITOR_KEY_PATH=./certs/config-editor/privkey.pem

# Domain + optional contact email the Tools tab uses to issue this editor's
# Let's Encrypt certificate (DNS must point here and port 80 must be reachable).
# CONFIG_EDITOR_CERT_DOMAIN=admin.example.com
# CONFIG_EDITOR_CERT_EMAIL=you@example.com

# Trusted-host allowlist file (IPv4/IPv6, one IP or CIDR per line)
# CONFIG_EDITOR_TRUSTEDHOSTS_PATH=./trustedhosts.txt

# Idle session timeout in milliseconds (default 1800000 = 30 minutes, min 60000)
# CONFIG_EDITOR_SESSION_TIMEOUT_MS=1800000

# pm2 process name the "Restart firewall" button acts on
# CONFIG_EDITOR_PM2_APP=bbsfirewall

# When a browser hits this editor's port with plain http:// (no TLS), reply
# with a 301 to the https:// URL instead of failing the handshake
# (ERR_EMPTY_RESPONSE). Same port, no extra listener. On by default; set to
# false to just drop such requests. The target host is CONFIG_EDITOR_CERT_DOMAIN
# if set (its cert matches), else the request's Host header.
# CONFIG_EDITOR_HTTP_REDIRECT_ENABLED=true

# Adds a "Reboot server" button to the Tools tab for Global Admin
# accounts - a full OS reboot, not just an app restart. Off by default.
# Meaningfully higher risk than the always-available "Restart firewall"
# button: this one reboots the whole host (unreachable for several minutes,
# and can need your hosting provider's own console to recover if the box
# doesn't actually come back on its own). Still requires typing "REBOOT" to
# confirm and a live pm2-boot-service check at request time even when true.
# REBOOT_ENABLED=false

# =============================================================================
# Management API (HTTPS admin, /api/* on CONFIG_EDITOR_PORT)
# Key-authenticated REST access to everything the config editor UI can do
# (read/write .env, edit the list files, restart, GeoIP/SSH-key/cert tools,
# system + firewall stats) — for a remote dashboard. Off by default. Requires
# CONFIG_EDITOR_ENABLED=true; the API has no listener of its own.
#
# Clients authenticate per request with:
#     Authorization: Bearer <API_KEY>      (or)      X-API-Key: <API_KEY>
#
# API_TRUSTEDHOSTS_PATH is an OPTIONAL source-IP allowlist (same file format as
# trustedhosts.txt). Unlike that file, empty or missing here means "any IP may
# call" — the key still applies. It is a separate gate: an API caller does NOT
# need to be listed in trustedhosts.txt.
# =============================================================================

# API_ENABLED=false
# API_KEY=change-this-to-a-long-random-string-min-24-chars
# API_TRUSTEDHOSTS_PATH=./api-trustedhosts.txt

# =============================================================================
# Status endpoint (GET /status on CONFIG_EDITOR_PORT) — for uptime monitors
# like Uptime Kuma. No API key, no login — unlike api-trustedhosts.txt above,
# an EMPTY or MISSING allowlist here means NOBODY may call it (fail-closed,
# same as trustedhosts.txt), since there's no key to fall back on. Requires
# CONFIG_EDITOR_ENABLED=true; no listener of its own.
# =============================================================================

# STATUS_TRUSTEDHOSTS_PATH=./status-trustedhosts.txt

# =============================================================================
# Logging — Console
# =============================================================================

# Console log level: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# Logging — Per-Proxy Files
# One daily-rotated log file per proxy service, each in its own subfolder:
#   logs/telnet/telnet-YYYY-MM-DD.log
#   logs/ssh/ssh-YYYY-MM-DD.log
#   logs/ssh-passthrough/ssh-passthrough-YYYY-MM-DD.log
#   logs/web/web-YYYY-MM-DD.log
#   logs/config-editor/config-editor-YYYY-MM-DD.log
#
# Verbosity levels (each includes the ones below it):
#   off         nothing
#   blocked     denials/blocks + errors                      (default)
#   connections + accepted connections, disconnects, warnings
#   info        + general informational lines
#   debug       + every action, including byte-level traces
# =============================================================================

# Master switch for all file logging
# LOG_FILE_ENABLED=false

# Base directory for log folders
# LOG_DIR=./logs

# Default level every proxy inherits unless it sets its own below
# LOG_FILE_LEVEL=blocked

# Per-proxy overrides (optional). Set _LOG_ENABLED=false to silence one proxy,
# or _LOG_LEVEL to give it a different verbosity than the default above.
# TELNET_LOG_ENABLED=true
# TELNET_LOG_LEVEL=blocked
# SSH_LOG_ENABLED=true
# SSH_LOG_LEVEL=connections
# SSH_PASSTHROUGH_LOG_ENABLED=true
# SSH_PASSTHROUGH_LOG_LEVEL=connections
# WEB_LOG_ENABLED=true
# WEB_LOG_LEVEL=blocked
# CONFIG_EDITOR_LOG_ENABLED=true
# CONFIG_EDITOR_LOG_LEVEL=connections

# =============================================================================
# SSH (optional)
# SSH_MODE selects what sits on the SSH port:
#   off         no SSH listener
#   terminate   firewall IS the SSH server — accepts any credentials and
#               forwards a plaintext session to the telnet backend. Use this for
#               backends with no SSH of their own. Encoding detection works here.
#               (Use telnet for reliable Zmodem/Ymodem transfers.)
#   passthrough firewall filters at the IP layer only and forwards the encrypted
#               SSH stream to a backend that runs its own SSH server. Preserves
#               pubkey/passwordless login, SFTP, and reliable file transfers.
# (Legacy: SSH_ENABLED=true is still honored and maps to SSH_MODE=terminate.)
# =============================================================================

# SSH_MODE=off
# SSH_LISTEN_PORT=2222

# --- terminate mode only ---
# SSH_HOST_KEY=./ssh_host_key
# SSH_CIPHERS=aes128-gcm@openssh.com,aes256-gcm@openssh.com,aes128-ctr,aes256-ctr,aes128-cbc,aes256-cbc,3des-cbc

# --- passthrough mode only ---
# Backend SSH server to forward the encrypted stream to.
# SSH_BACKEND_HOST defaults to BACKEND_HOST if unset.
# SSH_BACKEND_HOST=127.0.0.1
# SSH_BACKEND_PORT=22
# Send a PROXY Protocol v1 header to the SSH backend (default false). Only enable
# if the SSH backend understands PROXY Protocol — a plain SSH server will drop
# the handshake otherwise.
# SSH_PROXY_PROTOCOL=false
